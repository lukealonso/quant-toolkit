--- model.py
+++ model.py
@@ -738,6 +738,48 @@
         for args in weights:
             name, loaded_weight = args[:2]
             kwargs: dict = args[2] if len(args) > 2 else {}
+
+            # Transformers converts the original GLM-5.3 checkpoint names
+            # when loading Glm5Next. ModelOpt consequently exports those
+            # canonical names. This vLLM implementation uses the original
+            # parameter layout internally, so reverse the lossless renames.
+            canonical_to_runtime = (
+                (".attn_hc.fn", ".hc_attn_fn"),
+                (".attn_hc.base", ".hc_attn_base"),
+                (".attn_hc.scale", ".hc_attn_scale"),
+                (".ffn_hc.fn", ".hc_ffn_fn"),
+                (".ffn_hc.base", ".hc_ffn_base"),
+                (".ffn_hc.scale", ".hc_ffn_scale"),
+                (".self_attn.forget_gate.f_a_proj.", ".self_attn.f_a_proj."),
+                (".self_attn.forget_gate.f_b_proj.", ".self_attn.f_b_proj."),
+                (".self_attn.forget_gate.dt_bias", ".self_attn.dt_bias"),
+                (".self_attn.forget_gate.A_log", ".self_attn.A_log"),
+            )
+            for canonical_name, runtime_name in canonical_to_runtime:
+                name = name.replace(canonical_name, runtime_name)
+
+            # Transformers also fuses q/k/v conv1d weights along output dim.
+            # Split the global tensor first, then let each ColumnParallelLinear
+            # weight loader select this TP rank's output slice.
+            fused_conv_suffix = ".self_attn.conv1d.weight"
+            if name.endswith(fused_conv_suffix):
+                if loaded_weight.shape[0] % 3 != 0:
+                    raise ValueError(
+                        f"invalid canonical GLM-5.3 conv1d shape: "
+                        f"{name}={tuple(loaded_weight.shape)}"
+                    )
+                prefix = name[: -len(fused_conv_suffix)] + ".self_attn."
+                for part, part_weight in zip(
+                    ("q", "k", "v"), loaded_weight.chunk(3, dim=0), strict=True
+                ):
+                    part_name = prefix + part + "_conv1d.weight"
+                    param = params_dict[part_name]
+                    weight_loader = getattr(
+                        param, "weight_loader", default_weight_loader
+                    )
+                    weight_loader(param, part_weight, **kwargs)
+                    loaded_params.add(part_name)
+                continue
             if "rotary_emb.inv_freq" in name:
                 continue
 
